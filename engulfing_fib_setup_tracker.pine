indicator("MBA Pacman", overlay=true, max_lines_count=500, max_labels_count=500)

//------------------------------------------------------------------------------
// Inputs
//------------------------------------------------------------------------------
requireOppositeColor = input.bool(false, "Wymagaj przeciwnego koloru świecy objętej", display=display.none)
minSizeMultiple = input.float(2.0, "Min. rozmiar świecy objęcia", minval=0.1, step=0.1, tooltip="Ile razy większa musi być świeca objęcia od świecy obejmowanej, np. 2.0 oznacza minimum x2.", display=display.status_line)
sameColorSizeMultiple = input.float(4.0, "Min. rozmiar gdy świece nie są przeciwne", minval=0.1, step=0.1, tooltip="Ile razy większa musi być świeca objęcia od świecy obejmowanej, gdy obie świece mają ten sam kolor.", display=display.status_line)
entryFib = input.float(0.5, "Poziom wejścia Fibo", minval=0.0, maxval=1.0, step=0.05, display=display.status_line)
rewardR = input.float(2.0, "Cel zysku w R", minval=0.1, step=0.1, display=display.status_line)
useBreakEven = input.bool(false, "Włącz przesuwanie SL na BE", display=display.none)
breakEvenTriggerPct = input.float(85.0, "Przesuń SL na BE przy % drogi do TP", minval=1.0, maxval=99.0, step=1.0, display=display.none)
setupExpiryBars = input.int(20, "Anuluj niewypełniony setup po liczbie świec (0 = nigdy)", minval=0, display=display.none)
pendingInvalidationMode = input.string("Zamknięcie za TP", "Unieważnij oczekujący gdy", options=["Nigdy", "Dotknięcie TP", "Zamknięcie za TP"], display=display.none)
sameBarMode = input.string("Najpierw SL", "Gdy TP i SL trafione na tej samej świecy", options=["Najpierw SL", "Najpierw TP"], tooltip="TradingView na danych świecowych zna tylko OHLC, ale nie zna dokładnej kolejności ruchu ceny wewnątrz świecy. Ta opcja mówi, co liczyć jako pierwsze, gdy ta sama świeca dotknie i SL, i TP.", display=display.none)
pendingSameBarMode = input.string("Najpierw wejście", "Gdy oczekujące: wejście i TP na tej samej świecy", options=["Najpierw wejście", "Najpierw unieważnienie"], tooltip="Gdy setup jeszcze czeka na wejście, jedna świeca może jednocześnie dotknąć entry i poziomu unieważnienia przy TP. TradingView nie wie, co wydarzyło się pierwsze wewnątrz świecy, więc ta opcja wybiera założenie.", display=display.none)
useAtrFilter = input.bool(false, "Włącz filtr ATR", tooltip="Odfiltrowywanie setupów, których rozmiar odbiega od średniej", display=display.none)
atrLength = input.int(8, "Długość ATR", minval=1, display=display.none)
minBodyAtrPct = input.float(50.0, "Min. rozmiar świecy setupu (% ATR)", minval=0.0, step=1.0, display=display.none)
maxBodyAtrPct = input.float(250.0, "Maks. rozmiar świecy setupu (% ATR, 0 = brak)", minval=0.0, step=10.0, display=display.none)
useCloseWickFilter = input.bool(false, "Włącz filtr knota świecy objęcia", tooltip="Odfiltrowuje setupy, w których świeca objęcia ma zbyt duży knot działający na naszą niekorzyść: dla longa jest to górny knot, dla shorta dolny knot.", display=display.none)
maxCloseWickPct = input.float(25.0, "Maks. knot świecy setupu (%)", minval=0.0, maxval=100.0, step=1.0, tooltip="Dla longa liczony jest górny knot jako % z korpusu + górnego knota. Dla shorta liczony jest dolny knot jako % z korpusu + dolnego knota.", display=display.none)

showEntryLine = input.bool(true, "Rysuj Entry", group="Linie", display=display.none)
showStopLine = input.bool(true, "Rysuj SL", group="Linie", display=display.none)
showTargetLine = input.bool(true, "Rysuj TP", group="Linie", display=display.none)
fibProjectionBars = input.int(24, "Długość linii w świecach", minval=1, maxval=500, group="Linie", tooltip="Ile świec w prawo od setupu mają być rysowane linie Entry/SL/TP. Na 15m wartość 24 oznacza około 6 godzin.", display=display.none)
entryLineWidth = input.int(1, "Grubość Entry", minval=1, maxval=5, group="Linie", display=display.none)
stopLineWidth = input.int(1, "Grubość SL", minval=1, maxval=5, group="Linie", display=display.none)
targetLineWidth = input.int(1, "Grubość TP", minval=1, maxval=5, group="Linie", display=display.none)
entryLineStyleInput = input.string("Ciągła", "Styl Entry", options=["Ciągła", "Przerywana", "Kropkowana"], group="Linie", display=display.none)
stopLineStyleInput = input.string("Kropkowana", "Styl SL", options=["Ciągła", "Przerywana", "Kropkowana"], group="Linie", display=display.none)
targetLineStyleInput = input.string("Kropkowana", "Styl TP", options=["Ciągła", "Przerywana", "Kropkowana"], group="Linie", display=display.none)
maxVisibleSetups = input.int(60, "Maks. widocznych setupów", minval=1, maxval=90, tooltip="TradingView ma limit liczby rysowanych linii i etykiet. Starsze setupy są usuwane z wykresu, żeby wskaźnik nie przekroczył limitu i nie przestał działać.", display=display.none)
showTradeLabels = input.bool(true, "Pokazuj etykiety wejścia/wygranej/straty", display=display.none)
tradeLabelSizeInput = input.string("Mały", "Rozmiar etykiet transakcji", options=["Bardzo mały", "Mały", "Normalny", "Duży", "Bardzo duży"], display=display.none)
showFilteredSetups = input.bool(true, "Pokazuj odfiltrowane setupy", display=display.none)
filteredLabelSizeInput = input.string("Mały", "Rozmiar etykiet odfiltrowanych", options=["Bardzo mały", "Mały", "Normalny", "Duży", "Bardzo duży"], display=display.none)
alertFilteredSetups = input.bool(false, "Alerty dla odfiltrowanych setupów", group="Alerty", tooltip="UWAGA: po zmianie ustawień utwórz alert od nowa. Alerty TradingView zapamiętują ustawienia wskaźnika z momentu utworzenia alertu.", display=display.none)
showDashboard = input.bool(true, "Pokazuj panel", display=display.none)
dashPosInput = input.string("Prawy górny", "Pozycja panelu", options=["Prawy górny", "Lewy górny", "Prawy dolny", "Lewy dolny"], display=display.none)
maxCloseOpenGapAtrPct = input.float(5.0, "Maks. luka close-open (% ATR)", minval=0.0, step=0.5, group="Techniczne", tooltip="Pozwala wskaźnikowi poprawnie rozpoznać objęcie, gdy między zamknięciem poprzedniej świecy a otwarciem kolejnej jest mała luka cenowa. Luka jest uwzględniana tylko do tego limitu ATR, żeby duże gapy nie zaliczały fałszywych objęć.", display=display.none)

bullColor = color.rgb(24, 156, 112)
bearColor = color.rgb(219, 74, 94)
entryColor = input.color(color.rgb(242, 178, 62), "Kolor Entry", group="Linie", display=display.none)
stopColor = input.color(color.rgb(219, 74, 94), "Kolor SL", group="Linie", display=display.none)
tpColor = input.color(color.rgb(74, 166, 255), "Kolor TP", group="Linie", display=display.none)

//------------------------------------------------------------------------------
// Helpers
//------------------------------------------------------------------------------
f_dashboard_pos(string pos) =>
    switch pos
        "Lewy górny" => position.top_left
        "Prawy dolny" => position.bottom_right
        "Lewy dolny" => position.bottom_left
        => position.top_right

f_label_size(string sizeInput) =>
    switch sizeInput
        "Bardzo mały" => size.tiny
        "Normalny" => size.normal
        "Duży" => size.large
        "Bardzo duży" => size.huge
        => size.small

f_line_style(string styleInput) =>
    switch styleInput
        "Przerywana" => line.style_dashed
        "Kropkowana" => line.style_dotted
        => line.style_solid

f_keep_lines(array<line> items, int maxItems) =>
    while array.size(items) > maxItems
        line.delete(array.shift(items))

f_keep_labels(array<label> items, int maxItems) =>
    while array.size(items) > maxItems
        label.delete(array.shift(items))

f_push_line(array<line> items, line item, int maxItems) =>
    array.push(items, item)
    f_keep_lines(items, maxItems)

f_push_label(array<label> items, label item, int maxItems) =>
    array.push(items, item)
    f_keep_labels(items, maxItems)

f_filter_reasons(bool sizeFail, string sizeText, bool atrFail, string atrText, bool wickFail, string wickText) =>
    string result = ""
    result := sizeFail ? sizeText : result
    result := atrFail ? (result == "" ? atrText : result + "\n" + atrText) : result
    result := wickFail ? (result == "" ? wickText : result + "\n" + wickText) : result
    result

f_cap_line(line item, int endBar) =>
    if not na(item)
        line.set_x2(item, endBar)

f_cap_label(label item, int endBar) =>
    if not na(item)
        label.set_x(item, endBar)

f_cap_line_set(int idx, array<line> lineA, array<line> lineB, array<line> lineC, array<line> lineD, array<line> lineE, int endBar) =>
    f_cap_line(array.get(lineA, idx), endBar)
    f_cap_line(array.get(lineB, idx), endBar)
    f_cap_line(array.get(lineC, idx), endBar)
    f_cap_line(array.get(lineD, idx), endBar)
    f_cap_line(array.get(lineE, idx), endBar)

f_remove_line_set(int idx, array<line> lineA, array<line> lineB, array<line> lineC, array<line> lineD, array<line> lineE) =>
    array.remove(lineA, idx)
    array.remove(lineB, idx)
    array.remove(lineC, idx)
    array.remove(lineD, idx)
    array.remove(lineE, idx)

f_remove_pending(int idx, array<int> dirs, array<float> entries, array<float> stops, array<float> targets, array<int> bars) =>
    array.remove(dirs, idx)
    array.remove(entries, idx)
    array.remove(stops, idx)
    array.remove(targets, idx)
    array.remove(bars, idx)

f_remove_active(int idx, array<int> dirs, array<float> entries, array<float> stops, array<float> targets, array<int> bars, array<int> setupBars) =>
    array.remove(dirs, idx)
    array.remove(entries, idx)
    array.remove(stops, idx)
    array.remove(targets, idx)
    array.remove(bars, idx)
    array.remove(setupBars, idx)

//------------------------------------------------------------------------------
// State
//------------------------------------------------------------------------------
var int setupsFound = 0
var int tradesFilled = 0
var int wins = 0
var int losses = 0
var int breakEvenTrades = 0
var int invalidatedSetups = 0
var int expiredSetups = 0
var int oppositeColorSetups = 0
var int sameColorSetups = 0
var int lastSetupDir = 0
var int lastSetupBar = na
var float lastSetupEntry = na
var float lastSetupStop = na
var float lastSetupTarget = na
var float lastSetupMultiple = na
var string lastSetupStatus = "Brak"

var array<int> pendingDir = array.new_int()
var array<float> pendingEntry = array.new_float()
var array<float> pendingStop = array.new_float()
var array<float> pendingTp = array.new_float()
var array<int> pendingBar = array.new_int()
var array<line> pendingLineA = array.new_line()
var array<line> pendingLineB = array.new_line()
var array<line> pendingLineC = array.new_line()
var array<line> pendingLineD = array.new_line()
var array<line> pendingLineE = array.new_line()
var array<label> pendingEntryLabel = array.new_label()

var array<int> activeDir = array.new_int()
var array<float> activeEntry = array.new_float()
var array<float> activeStop = array.new_float()
var array<float> activeTp = array.new_float()
var array<int> activeBar = array.new_int()
var array<int> activeSetupBar = array.new_int()
var array<line> activeLineA = array.new_line()
var array<line> activeLineB = array.new_line()
var array<line> activeLineC = array.new_line()
var array<line> activeLineD = array.new_line()
var array<line> activeLineE = array.new_line()
var array<line> activeBeLine = array.new_line()
var array<label> activeEntryLabel = array.new_label()

var array<line> drawnLines = array.new_line()
var array<label> drawnLabels = array.new_label()
var table dashboard = table.new(f_dashboard_pos(dashPosInput), 2, 15, border_width=1)

maxLinesToKeep = math.min(maxVisibleSetups * 5, 480)
maxLabelsToKeep = math.min(maxVisibleSetups * 4, 480)
tradeLabelSize = f_label_size(tradeLabelSizeInput)
filteredLabelSize = f_label_size(filteredLabelSizeInput)
entryLineStyle = f_line_style(entryLineStyleInput)
stopLineStyle = f_line_style(stopLineStyleInput)
targetLineStyle = f_line_style(targetLineStyleInput)
isTradingTf = timeframe.isminutes and timeframe.multiplier == 15

//------------------------------------------------------------------------------
// Trade tracking
//------------------------------------------------------------------------------
activeCountForLoop = array.size(activeDir)
if isTradingTf and activeCountForLoop > 0
    for offset = 0 to activeCountForLoop - 1
        i = activeCountForLoop - 1 - offset
        dir = array.get(activeDir, i)
        entry = array.get(activeEntry, i)
        stop = array.get(activeStop, i)
        target = array.get(activeTp, i)
        entryBar = array.get(activeBar, i)
        setupBar = array.get(activeSetupBar, i)

        if bar_index > entryBar
            isBreakEvenStop = stop == entry
            hitStop = dir == 1 ? low <= stop : high >= stop
            hitTarget = dir == 1 ? high >= target : low <= target
            tradeClosed = hitStop or hitTarget
            tradeWon = hitTarget and not hitStop
            tradeBreakEven = useBreakEven and hitStop and isBreakEvenStop and not hitTarget
            if hitStop and hitTarget
                tradeWon := sameBarMode == "Najpierw TP"
                tradeBreakEven := useBreakEven and not tradeWon and isBreakEvenStop

            if tradeClosed
                if tradeWon
                    wins += 1
                else if tradeBreakEven
                    breakEvenTrades += 1
                else
                    losses += 1

                if setupBar == lastSetupBar
                    lastSetupStatus := tradeWon ? "Wygrana" : tradeBreakEven ? "BE" : "Strata"

                f_cap_line_set(i, activeLineA, activeLineB, activeLineC, activeLineD, activeLineE, bar_index)
                f_cap_line(array.get(activeBeLine, i), bar_index)
                f_cap_label(array.get(activeEntryLabel, i), bar_index)

                if showTradeLabels
                    resultPrice = tradeWon ? target : stop
                    resultText = tradeWon ? "Wygrana" : tradeBreakEven ? "BE" : "Strata"
                    resultColor = tradeWon ? color.new(tpColor, 0) : tradeBreakEven ? color.new(color.gray, 0) : color.new(bearColor, 0)
                    lbl = label.new(bar_index, resultPrice, resultText, style=label.style_label_left, textcolor=color.white, color=resultColor, size=tradeLabelSize)
                    f_push_label(drawnLabels, lbl, maxLabelsToKeep)

                f_remove_active(i, activeDir, activeEntry, activeStop, activeTp, activeBar, activeSetupBar)
                f_remove_line_set(i, activeLineA, activeLineB, activeLineC, activeLineD, activeLineE)
                array.remove(activeBeLine, i)
                array.remove(activeEntryLabel, i)
            else
                beTrigger = dir == 1 ? entry + (target - entry) * breakEvenTriggerPct * 0.01 : entry - (entry - target) * breakEvenTriggerPct * 0.01
                hitBreakEvenTrigger = useBreakEven and not isBreakEvenStop and (dir == 1 ? high >= beTrigger : low <= beTrigger)

                if hitBreakEvenTrigger
                    array.set(activeStop, i, entry)
                    if setupBar == lastSetupBar
                        lastSetupStatus := "Aktywny BE"
                    beLine = line.new(bar_index, entry, bar_index + fibProjectionBars, entry, color=color.new(color.gray, 20), style=line.style_dotted)
                    f_push_line(drawnLines, beLine, maxLinesToKeep)
                    array.set(activeBeLine, i, beLine)

                    if showTradeLabels
                        lbl = label.new(bar_index, entry, "SL -> BE", style=label.style_label_left, textcolor=color.white, color=color.new(color.gray, 0), size=tradeLabelSize)
                        f_push_label(drawnLabels, lbl, maxLabelsToKeep)

pendingCountForLoop = array.size(pendingDir)
if isTradingTf and pendingCountForLoop > 0
    for offset = 0 to pendingCountForLoop - 1
        i = pendingCountForLoop - 1 - offset
        dir = array.get(pendingDir, i)
        entry = array.get(pendingEntry, i)
        stop = array.get(pendingStop, i)
        target = array.get(pendingTp, i)
        setupBar = array.get(pendingBar, i)
        age = bar_index - setupBar

        touchedEntry = dir == 1 ? low <= entry : high >= entry
        pendingInvalidationHit = switch pendingInvalidationMode
            "Dotknięcie TP" => dir == 1 ? high >= target : low <= target
            "Zamknięcie za TP" => dir == 1 ? close >= target : close <= target
            => false
        invalidateSetup = barstate.isconfirmed and age > 0 and pendingInvalidationHit and (not touchedEntry or pendingSameBarMode == "Najpierw unieważnienie")
        isExpired = setupExpiryBars > 0 and age > setupExpiryBars

        if invalidateSetup
            invalidatedSetups += 1
            if setupBar == lastSetupBar
                lastSetupStatus := "Nieważny"
            f_cap_line_set(i, pendingLineA, pendingLineB, pendingLineC, pendingLineD, pendingLineE, bar_index)
            f_cap_label(array.get(pendingEntryLabel, i), bar_index)

            lbl = label.new(bar_index, target, "Nieważny", style=label.style_label_left, textcolor=color.white, color=color.new(color.gray, 0), size=tradeLabelSize)
            f_push_label(drawnLabels, lbl, maxLabelsToKeep)

            f_remove_pending(i, pendingDir, pendingEntry, pendingStop, pendingTp, pendingBar)
            f_remove_line_set(i, pendingLineA, pendingLineB, pendingLineC, pendingLineD, pendingLineE)
            array.remove(pendingEntryLabel, i)
        else if age > 0 and touchedEntry
            tradesFilled += 1
            array.push(activeDir, dir)
            array.push(activeEntry, entry)
            array.push(activeStop, stop)
            array.push(activeTp, target)
            array.push(activeBar, bar_index)
            array.push(activeSetupBar, setupBar)
            if setupBar == lastSetupBar
                lastSetupStatus := "Aktywny"
            array.push(activeLineA, array.get(pendingLineA, i))
            array.push(activeLineB, array.get(pendingLineB, i))
            array.push(activeLineC, array.get(pendingLineC, i))
            array.push(activeLineD, array.get(pendingLineD, i))
            array.push(activeLineE, array.get(pendingLineE, i))
            line emptyBeLine = na
            array.push(activeBeLine, emptyBeLine)
            array.push(activeEntryLabel, array.get(pendingEntryLabel, i))

            if showTradeLabels
                entryText = "Entry"
                entryLblColor = dir == 1 ? color.new(bullColor, 0) : color.new(bearColor, 0)
                lbl = label.new(bar_index, entry, entryText, style=label.style_label_left, textcolor=color.white, color=entryLblColor, size=tradeLabelSize)
                f_push_label(drawnLabels, lbl, maxLabelsToKeep)

            f_remove_pending(i, pendingDir, pendingEntry, pendingStop, pendingTp, pendingBar)
            f_remove_line_set(i, pendingLineA, pendingLineB, pendingLineC, pendingLineD, pendingLineE)
            array.remove(pendingEntryLabel, i)
        else if isExpired
            expiredSetups += 1
            if setupBar == lastSetupBar
                lastSetupStatus := "Wygasły"
            f_remove_pending(i, pendingDir, pendingEntry, pendingStop, pendingTp, pendingBar)
            f_remove_line_set(i, pendingLineA, pendingLineB, pendingLineC, pendingLineD, pendingLineE)
            array.remove(pendingEntryLabel, i)

//------------------------------------------------------------------------------
// Setup detection
//------------------------------------------------------------------------------
prevBear = close[1] < open[1]
prevBull = close[1] > open[1]
currBull = close > open
currBear = close < open

currBodyHigh = math.max(open, close)
currBodyLow = math.min(open, close)
prevBodyHigh = math.max(open[1], close[1])
prevBodyLow = math.min(open[1], close[1])
atrValue = ta.atr(atrLength)
closeOpenGap = na(close[1]) ? 0.0 : math.abs(open - close[1])
gapAtrCap = not na(atrValue) ? atrValue * maxCloseOpenGapAtrPct * 0.01 : 0.0
gapTolerance = math.min(closeOpenGap, gapAtrCap)
bodyBullEngulf = currBodyLow <= prevBodyLow + gapTolerance and currBodyHigh >= prevBodyHigh - gapTolerance
bodyBearEngulf = currBodyHigh >= prevBodyHigh - gapTolerance and currBodyLow <= prevBodyLow + gapTolerance
bullEngulf = bodyBullEngulf
bearEngulf = bodyBearEngulf

// For size comparison, only the body of the engulfing candle is used.
bullEngulfingSize = close - open
bearEngulfingSize = open - close
bullEngulfedSize = high[1] - close[1]  // ignores the engulfed candle's bottom wick
bearEngulfedSize = close[1] - low[1]   // ignores the engulfed candle's top wick

bullOppositeColor = prevBear
bearOppositeColor = prevBull
bullSameColor = prevBull
bearSameColor = prevBear

bullClassicMultiple = bullEngulfedSize > syminfo.mintick ? bullEngulfingSize / bullEngulfedSize : na
bearClassicMultiple = bearEngulfedSize > syminfo.mintick ? bearEngulfingSize / bearEngulfedSize : na
bullClassicSizeOk = not na(bullClassicMultiple) and bullClassicMultiple >= minSizeMultiple
bearClassicSizeOk = not na(bearClassicMultiple) and bearClassicMultiple >= minSizeMultiple

bullSameColorEngulfedSize = high[1] - open[1]
bearSameColorEngulfedSize = open[1] - low[1]
bullSameColorMultiple = bullSameColorEngulfedSize > syminfo.mintick ? bullEngulfingSize / bullSameColorEngulfedSize : na
bearSameColorMultiple = bearSameColorEngulfedSize > syminfo.mintick ? bearEngulfingSize / bearSameColorEngulfedSize : na
bullSameColorSizeOk = not na(bullSameColorMultiple) and bullSameColorMultiple >= sameColorSizeMultiple
bearSameColorSizeOk = not na(bearSameColorMultiple) and bearSameColorMultiple >= sameColorSizeMultiple

bullSameColorBreakout = close >= high[1] - gapTolerance
bearSameColorBreakout = close <= low[1] + gapTolerance
atrMaxDisabled = maxBodyAtrPct == 0.0
candleRange = high - low
atrRangePct = not na(atrValue) and atrValue > syminfo.mintick ? candleRange / atrValue * 100.0 : na
atrText = "ATR " + (na(atrRangePct) ? "n/a" : str.tostring(atrRangePct, "#") + "%")
bullAtrOk = not useAtrFilter or (not na(atrValue) and candleRange >= atrValue * minBodyAtrPct * 0.01 and (atrMaxDisabled or candleRange <= atrValue * maxBodyAtrPct * 0.01))
bearAtrOk = not useAtrFilter or (not na(atrValue) and candleRange >= atrValue * minBodyAtrPct * 0.01 and (atrMaxDisabled or candleRange <= atrValue * maxBodyAtrPct * 0.01))
filteredLabelGap = math.max(nz(atrValue, candleRange) * 0.015, syminfo.mintick * 10)
bullBadWick = high - close
bearBadWick = close - low
bullWickMeasureRange = high - open
bearWickMeasureRange = open - low
bullCloseWickPct = bullWickMeasureRange > syminfo.mintick ? bullBadWick / bullWickMeasureRange * 100.0 : 100.0
bearCloseWickPct = bearWickMeasureRange > syminfo.mintick ? bearBadWick / bearWickMeasureRange * 100.0 : 100.0
bullCloseWickPctRounded = math.floor(bullCloseWickPct)
bearCloseWickPctRounded = math.floor(bearCloseWickPct)
bullWickText = "Knot " + str.tostring(bullCloseWickPctRounded, "#") + "%"
bearWickText = "Knot " + str.tostring(bearCloseWickPctRounded, "#") + "%"
bullCloseWickOk = not useCloseWickFilter or bullCloseWickPctRounded <= maxCloseWickPct
bearCloseWickOk = not useCloseWickFilter or bearCloseWickPctRounded <= maxCloseWickPct

bullClassicCandidate = bullOppositeColor and currBull and bullEngulf
bearClassicCandidate = bearOppositeColor and currBear and bearEngulf
bullSameColorCandidate = not requireOppositeColor and bullSameColor and currBull and bullSameColorBreakout
bearSameColorCandidate = not requireOppositeColor and bearSameColor and currBear and bearSameColorBreakout
bullClassicSetup = bullClassicCandidate and bullClassicSizeOk
bearClassicSetup = bearClassicCandidate and bearClassicSizeOk
bullSameColorSetup = bullSameColorCandidate and bullSameColorSizeOk
bearSameColorSetup = bearSameColorCandidate and bearSameColorSizeOk

sizeNearMissTolerance = 0.2
bullClassicSizeNearMiss = bullClassicCandidate and not bullClassicSizeOk and not na(bullClassicMultiple) and bullClassicMultiple >= minSizeMultiple - sizeNearMissTolerance
bearClassicSizeNearMiss = bearClassicCandidate and not bearClassicSizeOk and not na(bearClassicMultiple) and bearClassicMultiple >= minSizeMultiple - sizeNearMissTolerance
bullSameColorSizeNearMiss = bullSameColorCandidate and not bullSameColorSizeOk and not na(bullSameColorMultiple) and bullSameColorMultiple >= sameColorSizeMultiple - sizeNearMissTolerance
bearSameColorSizeNearMiss = bearSameColorCandidate and not bearSameColorSizeOk and not na(bearSameColorMultiple) and bearSameColorMultiple >= sameColorSizeMultiple - sizeNearMissTolerance

bullPatternSetup = bullClassicSetup or bullSameColorSetup
bearPatternSetup = bearClassicSetup or bearSameColorSetup
bullSizeNearMiss = bullClassicSizeNearMiss or bullSameColorSizeNearMiss
bearSizeNearMiss = bearClassicSizeNearMiss or bearSameColorSizeNearMiss
bullFilteredCandidate = bullPatternSetup or bullSizeNearMiss
bearFilteredCandidate = bearPatternSetup or bearSizeNearMiss
bullSizeNearMissMultiple = bullClassicSizeNearMiss ? bullClassicMultiple : bullSameColorSizeNearMiss ? bullSameColorMultiple : na
bearSizeNearMissMultiple = bearClassicSizeNearMiss ? bearClassicMultiple : bearSameColorSizeNearMiss ? bearSameColorMultiple : na
bullSizeNearMissText = na(bullSizeNearMissMultiple) ? "" : "x" + str.tostring(bullSizeNearMissMultiple, "0.00")
bearSizeNearMissText = na(bearSizeNearMissMultiple) ? "" : "x" + str.tostring(bearSizeNearMissMultiple, "0.00")
bullAtrFail = not bullAtrOk
bearAtrFail = not bearAtrOk
bullWickFail = not bullCloseWickOk
bearWickFail = not bearCloseWickOk
bullFilterFail = bullSizeNearMiss or bullAtrFail or bullWickFail
bearFilterFail = bearSizeNearMiss or bearAtrFail or bearWickFail
bullFilterReasons = f_filter_reasons(bullSizeNearMiss, bullSizeNearMissText, bullAtrFail, atrText, bullWickFail, bullWickText)
bearFilterReasons = f_filter_reasons(bearSizeNearMiss, bearSizeNearMissText, bearAtrFail, atrText, bearWickFail, bearWickText)

bullSetup = isTradingTf and bullAtrOk and bullCloseWickOk and bullPatternSetup
bearSetup = isTradingTf and bearAtrOk and bearCloseWickOk and bearPatternSetup
confirmedBullSetup = bullSetup and barstate.isconfirmed
confirmedBearSetup = bearSetup and barstate.isconfirmed
confirmedBullFilteredSetup = isTradingTf and bullFilteredCandidate and bullFilterFail and barstate.isconfirmed
confirmedBearFilteredSetup = isTradingTf and bearFilteredCandidate and bearFilterFail and barstate.isconfirmed

plotshape(confirmedBullSetup, title="Wzrostowy setup objęcia", style=shape.triangleup, location=location.belowbar, color=bullColor, text="B", textcolor=color.white, size=size.tiny, display=display.pane)
plotshape(confirmedBearSetup, title="Spadkowy setup objęcia", style=shape.triangledown, location=location.abovebar, color=bearColor, text="S", textcolor=color.white, size=size.tiny, display=display.pane)

if showFilteredSetups and confirmedBullFilteredSetup
    lbl = label.new(bar_index, low - filteredLabelGap, bullFilterReasons, style=label.style_label_up, textcolor=color.black, color=color.yellow, size=filteredLabelSize)
    f_push_label(drawnLabels, lbl, maxLabelsToKeep)

if showFilteredSetups and confirmedBearFilteredSetup
    lbl = label.new(bar_index, high + filteredLabelGap, bearFilterReasons, style=label.style_label_down, textcolor=color.black, color=color.yellow, size=filteredLabelSize)
    f_push_label(drawnLabels, lbl, maxLabelsToKeep)

newBullAlert = confirmedBullSetup
newBearAlert = confirmedBearSetup
newBullFilteredAlert = alertFilteredSetups and confirmedBullFilteredSetup
newBearFilteredAlert = alertFilteredSetups and confirmedBearFilteredSetup
newSetupAlert = newBullAlert or newBearAlert
newFilteredSetupAlert = newBullFilteredAlert or newBearFilteredAlert
newPacmanAlert = newSetupAlert or newFilteredSetupAlert

alertcondition(newPacmanAlert, title="Nowy Pacman", message="Nowy Pacman")

if newPacmanAlert
    alert("Nowy Pacman", alert.freq_once_per_bar_close)

if confirmedBullSetup
    fibLow = math.min(low, low[1])
    fibHigh = math.max(high, high[1])
    entry = fibLow + (fibHigh - fibLow) * entryFib
    stop = fibLow
    risk = entry - stop
    target = entry + risk * rewardR

    if risk > syminfo.mintick
        setupsFound += 1
        lastSetupDir := 1
        lastSetupBar := bar_index
        lastSetupEntry := entry
        lastSetupStop := stop
        lastSetupTarget := target
        bullMeasuredEngulfedSize = bullOppositeColor ? bullEngulfedSize : bullSameColorEngulfedSize
        lastSetupMultiple := bullMeasuredEngulfedSize > syminfo.mintick ? bullEngulfingSize / bullMeasuredEngulfedSize : na
        lastSetupStatus := "Oczekujący"
        if bullOppositeColor
            oppositeColorSetups += 1
        else
            sameColorSetups += 1
        array.push(pendingDir, 1)
        array.push(pendingEntry, entry)
        array.push(pendingStop, stop)
        array.push(pendingTp, target)
        array.push(pendingBar, bar_index)

        line bullLineA = na
        line bullLineB = na
        line bullLineC = na
        line bullLineD = na
        line bullLineE = na
        label bullEntryLabel = na

        if showEntryLine or showStopLine or showTargetLine
            x1 = bar_index - 1
            x2 = bar_index + fibProjectionBars
            if showEntryLine
                bullLineB := line.new(x1, entry, x2, entry, color=color.new(entryColor, 0), width=entryLineWidth, style=entryLineStyle)
                f_push_line(drawnLines, bullLineB, maxLinesToKeep)
            if showStopLine
                bullLineD := line.new(bar_index, stop, x2, stop, color=color.new(stopColor, 20), width=stopLineWidth, style=stopLineStyle)
                f_push_line(drawnLines, bullLineD, maxLinesToKeep)
            if showTargetLine
                bullLineE := line.new(bar_index, target, x2, target, color=color.new(tpColor, 20), width=targetLineWidth, style=targetLineStyle)
                f_push_line(drawnLines, bullLineE, maxLinesToKeep)

        array.push(pendingLineA, bullLineA)
        array.push(pendingLineB, bullLineB)
        array.push(pendingLineC, bullLineC)
        array.push(pendingLineD, bullLineD)
        array.push(pendingLineE, bullLineE)
        array.push(pendingEntryLabel, bullEntryLabel)

if confirmedBearSetup
    fibHigh = math.max(high, high[1])
    fibLow = math.min(low, low[1])
    entry = fibHigh + (fibLow - fibHigh) * entryFib
    stop = fibHigh
    risk = stop - entry
    target = entry - risk * rewardR

    if risk > syminfo.mintick
        setupsFound += 1
        lastSetupDir := -1
        lastSetupBar := bar_index
        lastSetupEntry := entry
        lastSetupStop := stop
        lastSetupTarget := target
        bearMeasuredEngulfedSize = bearOppositeColor ? bearEngulfedSize : bearSameColorEngulfedSize
        lastSetupMultiple := bearMeasuredEngulfedSize > syminfo.mintick ? bearEngulfingSize / bearMeasuredEngulfedSize : na
        lastSetupStatus := "Oczekujący"
        if bearOppositeColor
            oppositeColorSetups += 1
        else
            sameColorSetups += 1
        array.push(pendingDir, -1)
        array.push(pendingEntry, entry)
        array.push(pendingStop, stop)
        array.push(pendingTp, target)
        array.push(pendingBar, bar_index)

        line bearLineA = na
        line bearLineB = na
        line bearLineC = na
        line bearLineD = na
        line bearLineE = na
        label bearEntryLabel = na

        if showEntryLine or showStopLine or showTargetLine
            x1 = bar_index - 1
            x2 = bar_index + fibProjectionBars
            if showEntryLine
                bearLineB := line.new(x1, entry, x2, entry, color=color.new(entryColor, 0), width=entryLineWidth, style=entryLineStyle)
                f_push_line(drawnLines, bearLineB, maxLinesToKeep)
            if showStopLine
                bearLineD := line.new(bar_index, stop, x2, stop, color=color.new(stopColor, 20), width=stopLineWidth, style=stopLineStyle)
                f_push_line(drawnLines, bearLineD, maxLinesToKeep)
            if showTargetLine
                bearLineE := line.new(bar_index, target, x2, target, color=color.new(tpColor, 20), width=targetLineWidth, style=targetLineStyle)
                f_push_line(drawnLines, bearLineE, maxLinesToKeep)

        array.push(pendingLineA, bearLineA)
        array.push(pendingLineB, bearLineB)
        array.push(pendingLineC, bearLineC)
        array.push(pendingLineD, bearLineD)
        array.push(pendingLineE, bearLineE)
        array.push(pendingEntryLabel, bearEntryLabel)

//------------------------------------------------------------------------------
// Dashboard
//------------------------------------------------------------------------------
if showDashboard and barstate.islast
    lastDirText = lastSetupDir == 1 ? "Long" : lastSetupDir == -1 ? "Short" : "Brak"
    lastEntryText = na(lastSetupEntry) ? "-" : str.tostring(lastSetupEntry, "#.##")
    lastStopText = na(lastSetupStop) ? "-" : str.tostring(lastSetupStop, "#.##")
    lastTargetText = na(lastSetupTarget) ? "-" : str.tostring(lastSetupTarget, "#.##")
    lastMultipleText = na(lastSetupMultiple) ? "-" : "x" + str.tostring(lastSetupMultiple, "#.00")
    lastStatusText = na(lastSetupEntry) ? "-" : lastSetupStatus

    table.clear(dashboard, 0, 0, 1, 14)
    table.cell(dashboard, 0, 0, "Ostatni setup", text_color=color.white, bgcolor=color.rgb(32, 38, 46))
    table.cell(dashboard, 1, 0, isTradingTf ? lastDirText : "Tylko 15m", text_color=color.white, bgcolor=color.rgb(32, 38, 46))
    if isTradingTf
        table.cell(dashboard, 0, 1, "Entry", text_color=color.white, bgcolor=color.rgb(20, 24, 30))
        table.cell(dashboard, 1, 1, lastEntryText, text_color=color.white, bgcolor=color.rgb(20, 24, 30))
        table.cell(dashboard, 0, 2, "SL", text_color=color.white, bgcolor=color.rgb(20, 24, 30))
        table.cell(dashboard, 1, 2, lastStopText, text_color=color.white, bgcolor=color.rgb(20, 24, 30))
        table.cell(dashboard, 0, 3, "TP", text_color=color.white, bgcolor=color.rgb(20, 24, 30))
        table.cell(dashboard, 1, 3, lastTargetText, text_color=color.white, bgcolor=color.rgb(20, 24, 30))
        table.cell(dashboard, 0, 4, "Stan", text_color=color.white, bgcolor=color.rgb(20, 24, 30))
        table.cell(dashboard, 1, 4, lastStatusText, text_color=color.white, bgcolor=color.rgb(20, 24, 30))
        table.cell(dashboard, 0, 5, "Rozmiar", text_color=color.white, bgcolor=color.rgb(20, 24, 30))
        table.cell(dashboard, 1, 5, lastMultipleText, text_color=color.white, bgcolor=color.rgb(20, 24, 30))
    else
        table.cell(dashboard, 0, 1, "Status", text_color=color.white, bgcolor=color.rgb(20, 24, 30))
        table.cell(dashboard, 1, 1, "Zły TF", text_color=color.white, bgcolor=color.rgb(20, 24, 30))
        table.cell(dashboard, 0, 2, "Użyj wykresu", text_color=color.white, bgcolor=color.rgb(20, 24, 30))
        table.cell(dashboard, 1, 2, "15m", text_color=color.white, bgcolor=color.rgb(20, 24, 30))
